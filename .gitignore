# Data files (large, generated) - DVC tracks via .dvc files
data/*.csv

# Graph snapshots (large pickles, regenerated from repos)
data/graph_snapshots/

# MLflow tracking database
mlflow.db
mlflow.db.bak*
# SQLite databases the API creates on first run (issues, outcomes, budget).
data/*.db

# MLflow tracking directory
mlruns/

# DVC cache (tracked by DVC, not git)
.dvc/cache/
.dvc/tmp/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# The dashboard's build output stays ignored, but the directory itself has to
# exist: api/Dockerfile does `COPY dashboard/dist/ ./dashboard/dist/`, and a
# docker build from a fresh clone failed on it for 95 Gate 3 runs. Only the
# place-holder is tracked, so a real `npm run build` output is still never
# committed.
!dashboard/dist/
dashboard/dist/*
!dashboard/dist/.gitkeep

# Virtual environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Cloned repos (too large for git)
repos/

# MLflow database backups
mlflow.db.backup-*

# A local uvicorn log, and any other stray run output.
api_server.log

# Diagnostics the workflows upload when they fail, and verify_all writes always.
# They are deliberately not committed: they describe one run on one machine.
verify_all.log
suite.log
hook-tests.log
smoke-tests.log
compose-build.log
compose-logs.log
trace.log
# Node (dashboard)
node_modules/

# The onboarding demo repository is generated: `python -m tools.make_demo_repo`.
# Only its report is committed, not the checkout.
demo/
# Packed npm artifacts (`npm pack` in cli/).
cli/*.tgz

# Terraform: the variable file holds the OCI private key path and the secrets
# that belong to one machine's state, never to the repository.
deploy/oracle/terraform.tfvars
deploy/oracle/.terraform/
deploy/oracle/*.tfstate
deploy/oracle/*.tfstate.*
