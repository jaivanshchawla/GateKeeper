{
  "name": "gatekeeper",
  "version": "1.0.0",
  "private": true,
  "description": "Husky-managed git hooks for the Gatekeeper MLOps quality gate",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "hooks:init": "node .husky/install.mjs && python -m scripts.hooks.verify",
    "hooks:install": "node .husky/install.mjs",
    "hooks:repair": "python -m scripts.hooks.verify --fix",
    "hooks:uninstall": "node .husky/uninstall.mjs",
    "hooks:verify": "python -m scripts.hooks.verify",
    "hooks:list": "python -m scripts.hooks.verify --list",
    "lint:python": "python -m ruff check .",
    "format:python": "python -m ruff format .",
    "test:python": "python -m pytest tests/ -q",
    "gate1": "python scripts/pre_push_score.py"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
